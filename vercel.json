{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        { "source": "/training/:path*", "destination": "/index.html" },
        { "source": "/workspace", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "runtime": "python3.12",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 300,
          "includeFiles": "ml/model.json"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
